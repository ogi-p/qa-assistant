# JIRA API Configuration Template
# Copy this file to .env and fill in your actual credentials

# Your JIRA email address
JIRA_MCP_LOGIN=your.email@your-company.com

# Your JIRA API token (generate from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_MCP_TOKEN=your_api_token_here

# Optional: JIRA URL (usually doesn't need to change)
# JIRA_URL=https://your-company.atlassian.net
