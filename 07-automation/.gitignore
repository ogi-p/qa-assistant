# Playwright Automation - Git Ignore
# This file ensures only essential framework files are committed
# All generated artifacts and dependencies should be excluded

# ============================================
# Generated Test Artifacts (Always Regenerate)
# ============================================

# Test execution results
test-results/
playwright-report/
results.json
junit.xml

# Test screenshots (generated during test runs)
screenshots/actual/
screenshots/diff/
# Note: Keep baseline screenshots ONLY if using visual regression
# screenshots/baseline/

# Test recordings (generated during record sessions)
recordings/*.webm
recordings/*.mp4
recordings/*.json
!recordings/.gitkeep

# Test reports (generated after test runs)
reports/

# ============================================
# Dependencies (Download on New Machine)
# ============================================

# Node modules (installed via npm install)
node_modules/

# Lock files (regenerated on install)
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================================
# Environment & Credentials (Never Commit)
# ============================================

# Environment files with credentials
.env
.env.local
.env.*.local
*.env

# ============================================
# Caches & System Files (Platform Specific)
# ============================================

# Playwright browser cache
.playwright/
.playwright-mcp/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ============================================
# Logs & Temporary Files (Not Needed)
# ============================================

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Debug output
debug/
coverage/

# ============================================
# Project-Specific Test Scripts (Local Only)
# ============================================

# Exclude all project-specific test implementations
# These are generated per-project and should remain local
scripts/functional/*/
scripts/regression/*/
scripts/api/*/
!scripts/functional/.gitkeep
!scripts/regression/.gitkeep
!scripts/api/.gitkeep

# ============================================
# What SHOULD Be Committed
# ============================================
# ✓ config/ - All configuration files
# ✓ templates/ - Test generation templates
# ✓ scripts/common/ - Shared test helpers
# ✓ commands/ - CLI command scripts
# ✓ package.json - Dependency list
# ✓ README.md - Documentation
# ✓ .gitkeep files - Directory structure
# ✗ scripts/functional/*/ - Project tests (local)
# ✗ scripts/regression/*/ - Project tests (local)
# ✗ scripts/api/*/ - Project tests (local)

